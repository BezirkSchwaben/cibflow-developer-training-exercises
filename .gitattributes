# Zeilenenden: Git speichert Text mit LF und wandelt beim Checkout passend um.
* text=auto

# Diese Dateien laufen in Linux-Containern oder werden dort gelesen.
# Mit CRLF bricht das Init-Skript ab ("illegal option -"),
# deshalb immer LF, auch nach einem Checkout unter Windows.
# Modell und Formulare stecken außerdem im Projekt-ZIP, das byte-gleich neu gebaut werden muss.
*.sh          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.properties  text eol=lf
*.xml         text eol=lf
*.bpmn        text eol=lf
*.json        text eol=lf
*.py          text eol=lf
*.http        text eol=lf

# Windows-Skripte brauchen CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Visual Studio schreibt Solution-Dateien mit CRLF.
*.sln   text eol=crlf

# Binärdateien nie umwandeln.
*.png   binary
*.jpg   binary
*.zip   binary

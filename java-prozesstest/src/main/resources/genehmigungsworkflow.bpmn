<?xml version="1.0" encoding="UTF-8"?>
<!--
  Genehmigungsworkflow, Vorlage für den Entwickler-Track.

  Gleiche IDs, gleiches Layout und gleiche Logik wie das Modell der Schulung
  (camunda:initiator="antragsteller", Topic genehmigung-verbuchen, Platzhalter
  an den Send Tasks). Die Formulare hängen über den CIB-Baustein "CIB easyForm"
  (im Modeler: Vorlage, Auswählen) am Modell: das easyForm antragsformular am
  Start-Event, genehmigungsformular an "Antrag prüfen". Wie der Baustein setzen
  beide einen Speicherpunkt danach (camunda:asyncAfter).

  Die Formulare selbst liegen nicht im BPMN. Sie kommen mit dem Projekt-ZIP
  prozess/genehmigungsworkflow-projekt.zip ins Prozessmanagement.

  Die Process ID Process_Genehmigung ist die der Vorlage. In der Schulung
  ersetzt ihr diese Datei durch euer eigenes Modell mit eurem Key.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_Genehmigungsworkflow"
                  targetNamespace="https://miragon.io/schulung/genehmigungsworkflow"
                  exporter="Miragon"
                  exporterVersion="1.0">

  <bpmn:collaboration id="Collaboration_Genehmigung">
    <bpmn:participant id="Participant_Genehmigung" name="Genehmigungsworkflow" processRef="Process_Genehmigung" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Genehmigung" name="Genehmigungsworkflow" isExecutable="true" camunda:versionTag="1.0" camunda:historyTimeToLive="P365D">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Antragsteller" name="Antragsteller:in">
        <bpmn:flowNodeRef>StartEvent_Antrag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Nachbessern</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Genehmigung" name="Genehmigende Stelle">
        <bpmn:flowNodeRef>Task_Pruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Erinnern</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Erinnert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Entscheidung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Verbuchen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Genehmigt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ablehnen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Abgelehnt</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Antrag" name="Antrag eingereicht" camunda:modelerTemplate="start-event-easy-form-json-5.4.2" camunda:asyncAfter="true" camunda:formKey="embedded:/camunda/app/tasklist/ui-element-templates/startform/template.html?template=easy-form-template" camunda:initiator="antragsteller">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="easyStartFormName" type="string" defaultValue="antragsformular" />
        </camunda:formData>
        <camunda:field name="easyStartFormId">
          <camunda:string>easyStartFormId</camunda:string>
        </camunda:field>
        <camunda:field name="easyStartFormName">
          <camunda:string>easyStartFormName</camunda:string>
        </camunda:field>
        <camunda:field name="easyStartFormVersion">
          <camunda:string>easyStartFormVersion</camunda:string>
        </camunda:field>
        <camunda:field name="formularStartContent">
          <camunda:string>formularStartContent</camunda:string>
        </camunda:field>
        <camunda:properties>
          <camunda:property name="documentation" value="Mit diesem Element Template wird zum Prozessstart ein Easy Form Formular eingebunden." />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_Pruefen</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_Pruefen" name="Antrag prüfen" camunda:modelerTemplate="user-task-easy-form-json-3.0.1" camunda:asyncAfter="true" camunda:formKey="embedded:/camunda/app/tasklist/ui-element-templates/template.html" camunda:candidateGroups="genehmiger">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="formReference">easy-form-template</camunda:inputParameter>
          <camunda:inputParameter name="easyFormPresetValues" />
          <camunda:inputParameter name="easyFormPresetVariables" />
          <camunda:inputParameter name="dropdownChoice">yes</camunda:inputParameter>
          <camunda:inputParameter name="easyFormName">genehmigungsformular</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:properties>
          <camunda:property name="documentation" value="Einbindung von CIB easy-forms in Prozessen." />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Pruefen</bpmn:incoming>
      <bpmn:incoming>Flow_Nachbessern_Pruefen</bpmn:incoming>
      <bpmn:outgoing>Flow_Pruefen_Gateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="Boundary_Timer" name="3 Tage ohne Entscheidung" cancelActivity="false" attachedToRef="Task_Pruefen">
      <bpmn:outgoing>Flow_Timer_Erinnern</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:sendTask id="Task_Erinnern" name="Erinnerung senden" camunda:expression="${execution.setVariable('erinnerungGesendet', true)}">
      <bpmn:incoming>Flow_Timer_Erinnern</bpmn:incoming>
      <bpmn:outgoing>Flow_Erinnern_End</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="End_Erinnert" name="Erinnert">
      <bpmn:incoming>Flow_Erinnern_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gateway_Entscheidung" name="Entscheidung?">
      <bpmn:incoming>Flow_Pruefen_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Genehmigt</bpmn:outgoing>
      <bpmn:outgoing>Flow_Abgelehnt</bpmn:outgoing>
      <bpmn:outgoing>Flow_Nachbesserung</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Verbuchen" name="Genehmigung verbuchen" camunda:type="external" camunda:topic="genehmigung-verbuchen">
      <bpmn:incoming>Flow_Genehmigt</bpmn:incoming>
      <bpmn:outgoing>Flow_Verbuchen_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_Genehmigt" name="Antrag genehmigt">
      <bpmn:incoming>Flow_Verbuchen_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sendTask id="Task_Ablehnen" name="Ablehnung mitteilen" camunda:expression="${execution.setVariable('ablehnungMitgeteilt', true)}">
      <bpmn:incoming>Flow_Abgelehnt</bpmn:incoming>
      <bpmn:outgoing>Flow_Ablehnen_End</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="End_Abgelehnt" name="Antrag abgelehnt">
      <bpmn:incoming>Flow_Ablehnen_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_Nachbessern" name="Antrag nachbessern" camunda:assignee="${antragsteller}">
      <bpmn:incoming>Flow_Nachbesserung</bpmn:incoming>
      <bpmn:outgoing>Flow_Nachbessern_Pruefen</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_Start_Pruefen" sourceRef="StartEvent_Antrag" targetRef="Task_Pruefen" />
    <bpmn:sequenceFlow id="Flow_Pruefen_Gateway" sourceRef="Task_Pruefen" targetRef="Gateway_Entscheidung" />
    <bpmn:sequenceFlow id="Flow_Genehmigt" name="genehmigt" sourceRef="Gateway_Entscheidung" targetRef="Task_Verbuchen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${entscheidung == 'genehmigt'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Verbuchen_End" sourceRef="Task_Verbuchen" targetRef="End_Genehmigt" />
    <bpmn:sequenceFlow id="Flow_Abgelehnt" name="abgelehnt" sourceRef="Gateway_Entscheidung" targetRef="Task_Ablehnen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${entscheidung == 'abgelehnt'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Ablehnen_End" sourceRef="Task_Ablehnen" targetRef="End_Abgelehnt" />
    <bpmn:sequenceFlow id="Flow_Nachbesserung" name="Nachbesserung nötig" sourceRef="Gateway_Entscheidung" targetRef="Task_Nachbessern">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${entscheidung == 'nachbessern'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Nachbessern_Pruefen" sourceRef="Task_Nachbessern" targetRef="Task_Pruefen" />
    <bpmn:sequenceFlow id="Flow_Timer_Erinnern" sourceRef="Boundary_Timer" targetRef="Task_Erinnern" />
    <bpmn:sequenceFlow id="Flow_Erinnern_End" sourceRef="Task_Erinnern" targetRef="End_Erinnert" />

    <bpmn:textAnnotation id="Annotation_Worker">
      <bpmn:text>External Task · C#-Worker</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Worker" sourceRef="Task_Verbuchen" targetRef="Annotation_Worker" />

    <bpmn:textAnnotation id="Annotation_Startform">
      <bpmn:text>Startformular: Antrag</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Startform" sourceRef="StartEvent_Antrag" targetRef="Annotation_Startform" />

    <bpmn:textAnnotation id="Annotation_Taskform">
      <bpmn:text>Task-Formular: Genehmigung</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Taskform" sourceRef="Task_Pruefen" targetRef="Annotation_Taskform" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Genehmigung">

      <bpmndi:BPMNShape id="Participant_Genehmigung_di" bpmnElement="Participant_Genehmigung" isHorizontal="true">
        <dc:Bounds x="150" y="60" width="1040" height="480" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Antragsteller_di" bpmnElement="Lane_Antragsteller" isHorizontal="true">
        <dc:Bounds x="180" y="60" width="1010" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Genehmigung_di" bpmnElement="Lane_Genehmigung" isHorizontal="true">
        <dc:Bounds x="180" y="240" width="1010" height="300" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_Antrag_di" bpmnElement="StartEvent_Antrag">
        <dc:Bounds x="230" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="272" y="158" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Nachbessern_di" bpmnElement="Task_Nachbessern">
        <dc:Bounds x="560" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Pruefen_di" bpmnElement="Task_Pruefen">
        <dc:Bounds x="340" y="290" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Boundary_Timer_di" bpmnElement="Boundary_Timer">
        <dc:Bounds x="402" y="352" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="446" y="372" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Erinnern_di" bpmnElement="Task_Erinnern">
        <dc:Bounds x="340" y="430" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="End_Erinnert_di" bpmnElement="End_Erinnert">
        <dc:Bounds x="480" y="452" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="478" y="495" width="42" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Entscheidung_di" bpmnElement="Gateway_Entscheidung" isMarkerVisible="true">
        <dc:Bounds x="505" y="305" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="560" y="288" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Verbuchen_di" bpmnElement="Task_Verbuchen">
        <dc:Bounds x="640" y="290" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="End_Genehmigt_di" bpmnElement="End_Genehmigt">
        <dc:Bounds x="800" y="312" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="776" y="355" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Ablehnen_di" bpmnElement="Task_Ablehnen">
        <dc:Bounds x="640" y="410" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="End_Abgelehnt_di" bpmnElement="End_Abgelehnt">
        <dc:Bounds x="800" y="432" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="777" y="475" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Annotation_Worker_di" bpmnElement="Annotation_Worker">
        <dc:Bounds x="900" y="290" width="170" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Annotation_Startform_di" bpmnElement="Annotation_Startform">
        <dc:Bounds x="300" y="80" width="150" height="34" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Annotation_Taskform_di" bpmnElement="Annotation_Taskform">
        <dc:Bounds x="200" y="470" width="120" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_Start_Pruefen_di" bpmnElement="Flow_Start_Pruefen">
        <di:waypoint x="248" y="168" />
        <di:waypoint x="248" y="330" />
        <di:waypoint x="340" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Pruefen_Gateway_di" bpmnElement="Flow_Pruefen_Gateway">
        <di:waypoint x="440" y="330" />
        <di:waypoint x="505" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Genehmigt_di" bpmnElement="Flow_Genehmigt">
        <di:waypoint x="555" y="330" />
        <di:waypoint x="640" y="330" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="572" y="312" width="52" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Verbuchen_End_di" bpmnElement="Flow_Verbuchen_End">
        <di:waypoint x="740" y="330" />
        <di:waypoint x="800" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Abgelehnt_di" bpmnElement="Flow_Abgelehnt">
        <di:waypoint x="530" y="355" />
        <di:waypoint x="530" y="450" />
        <di:waypoint x="640" y="450" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="538" y="400" width="50" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Ablehnen_End_di" bpmnElement="Flow_Ablehnen_End">
        <di:waypoint x="740" y="450" />
        <di:waypoint x="800" y="450" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Nachbesserung_di" bpmnElement="Flow_Nachbesserung">
        <di:waypoint x="530" y="305" />
        <di:waypoint x="530" y="170" />
        <di:waypoint x="560" y="170" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="440" y="196" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Nachbessern_Pruefen_di" bpmnElement="Flow_Nachbessern_Pruefen">
        <di:waypoint x="560" y="130" />
        <di:waypoint x="390" y="130" />
        <di:waypoint x="390" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Timer_Erinnern_di" bpmnElement="Flow_Timer_Erinnern">
        <di:waypoint x="420" y="388" />
        <di:waypoint x="420" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Erinnern_End_di" bpmnElement="Flow_Erinnern_End">
        <di:waypoint x="440" y="470" />
        <di:waypoint x="480" y="470" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Association_Worker_di" bpmnElement="Association_Worker">
        <di:waypoint x="740" y="300" />
        <di:waypoint x="900" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Association_Startform_di" bpmnElement="Association_Startform">
        <di:waypoint x="262" y="138" />
        <di:waypoint x="300" y="106" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Association_Taskform_di" bpmnElement="Association_Taskform">
        <di:waypoint x="350" y="370" />
        <di:waypoint x="300" y="470" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

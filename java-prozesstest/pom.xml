<?xml version="1.0" encoding="UTF-8"?>
<!--
  Prozesstest in Java für den Genehmigungsworkflow: Übung in Kapitel 12, Demo in Kapitel 10.
  Engine und Datenbank laufen im Speicher, ohne Server und ohne Spring Boot.
  Alle Läufe mit ./mvnw test (Windows: .\mvnw.cmd test), Anleitung in README.md.
  Maven selbst ist über .mvn/jvm.config leiser gestellt.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.miragon.schulung</groupId>
  <artifactId>java-prozesstest</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>Prozesstest Genehmigungsworkflow</name>

  <properties>
    <!-- Voraussetzung der Schulung ist JDK 21, neuere JDKs bauen dasselbe -->
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Die Testbibliotheken folgen der Version von CIB seven (Maven Central) -->
    <cibseven.version>2.2.0</cibseven.version>
    <junit.version>5.14.4</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <h2.version>2.3.232</h2.version>
    <slf4j.version>2.0.17</slf4j.version>

    <!-- Zeichen im Testbaum. Zeigt die Konsole ? statt ✔ und ✘: -Dbaum.theme=ASCII -->
    <baum.theme>UNICODE</baum.theme>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.cibseven.bpm</groupId>
        <artifactId>cibseven-bom</artifactId>
        <version>${cibseven.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Die Engine selbst, im Test mit H2 im Speicher -->
    <dependency>
      <groupId>org.cibseven.bpm</groupId>
      <artifactId>cibseven-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- ProcessEngineExtension und @Deployment für JUnit 5 -->
    <dependency>
      <groupId>org.cibseven.bpm</groupId>
      <artifactId>cibseven-bpm-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Prüfungen wie isWaitingAt, hasPassed, isEnded -->
    <dependency>
      <groupId>org.cibseven.bpm</groupId>
      <artifactId>cibseven-bpm-assert</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${h2.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Logausgabe der Engine, leise gestellt in src/test/resources/simplelogger.properties -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <!-- 3.5.3 ist die Version, gegen die der Tree-Reporter gebaut ist -->
        <version>3.5.3</version>
        <dependencies>
          <dependency>
            <groupId>me.fabriciorby</groupId>
            <artifactId>maven-surefire-junit5-tree-reporter</artifactId>
            <version>1.5.1</version>
          </dependency>
        </dependencies>
        <configuration>
          <!--
            Testausgabe als Baum mit den @DisplayName. Die Meldungen der roten Tests stehen darunter
            unter "Results", je Test eine Zeile mit dem Methodennamen, ohne die langen Stacktraces
            der Engine. Die vollständigen Berichte und die Logs aus dem Test liegen in
            target/surefire-reports, auf der Konsole erscheinen die Logs nicht.
          -->
          <reportFormat>plain</reportFormat>
          <consoleOutputReporter>
            <disable>true</disable>
          </consoleOutputReporter>
          <statelessTestsetInfoReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5StatelessTestsetInfoTreeReporter">
            <theme>${baum.theme}</theme>
            <printStacktraceOnError>false</printStacktraceOnError>
            <printStacktraceOnFailure>false</printStacktraceOnFailure>
            <printBlankLineBetweenTests>false</printBlankLineBetweenTests>
          </statelessTestsetInfoReporter>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>

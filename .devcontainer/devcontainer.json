{
  "name": "Cibflow Training",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
      ],
      "settings": {
      }
    }
  },
  "mounts": [
    "source=/etc/ssl/certs,target=/etc/ssl/certs,type=bind,readonly",
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "runArgs": [
    "--network=cibflow-training_default"
    // "--network=host"
  ],
  "remoteEnv": {
    "LC_ALL": "C.UTF-8",
    "DOTNET_ENVIRONMENT": "devcontainer",
    "no_proxy": "flow-cibseven-spring,flow-webclient,ui-element-template,easy-form,flow-modeler,flow-process-management,flow-resource,rechte,init",
    "NO_PROXY": "flow-cibseven-spring,flow-webclient,ui-element-template,easy-form,flow-modeler,flow-process-management,flow-resource,rechte,init"
  }
}
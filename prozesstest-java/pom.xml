<?xml version="1.0" encoding="UTF-8"?>
<!--
  Prozesstest in Java für den Genehmigungsworkflow: Übung in Kapitel 12, Demo in Kapitel 10.
  Engine und Datenbank laufen im Speicher, ohne Server und ohne Spring Boot.
  Alle Läufe mit ./mvnw test (Windows: .\mvnw.cmd test), Anleitung in prozesstest-java/README.md.
  Maven selbst ist über .mvn/jvm.config leiser gestellt.
  Process ID, Element-IDs, Topic und Fehlercode lesen die Tests aus Klassen, die bpmn-to-code bei jedem Lauf
  aus den Modellen in src/main/resources erzeugt, unter target/generated-test-sources/bpmn-to-code.
  Welche Elemente und Pfeile des Modells die Tests durchlaufen haben, zeigt nach jedem Lauf je Testklasse
  ein HTML-Bericht unter target/process-test-coverage.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.miragon.schulung</groupId>
  <artifactId>prozesstest-java</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>Prozesstest Genehmigungsworkflow</name>

  <properties>
    <!-- Voraussetzung der Schulung ist JDK 21, neuere JDKs bauen dasselbe -->
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Die Testbibliotheken folgen der Version von CIB seven (Maven Central) -->
    <cibseven.version>2.2.0</cibseven.version>
    <junit.version>5.14.4</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <h2.version>2.3.232</h2.version>
    <slf4j.version>2.0.17</slf4j.version>

    <!-- bpmn-to-code von Miragon (Maven Central) erzeugt aus jedem Modell eine Klasse mit seinen IDs -->
    <bpmn-to-code.version>5.2.0</bpmn-to-code.version>
    <bpmn-api.ordner>${project.build.directory}/generated-test-sources/bpmn-to-code</bpmn-api.ordner>

    <!-- CIB seven Process Test Coverage, Community-Extension von CIB seven (Maven Central), läuft mit CIB seven 1.1 bis 2.2 -->
    <process-test-coverage.version>2.2.0</process-test-coverage.version>

    <!-- Zeichen im Testbaum. Zeigt die Konsole ? statt ✔ und ✘: -Dbaum.theme=ASCII -->
    <baum.theme>UNICODE</baum.theme>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.cibseven.bpm</groupId>
        <artifactId>cibseven-bom</artifactId>
        <version>${cibseven.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Die Engine selbst, im Test mit H2 im Speicher -->
    <dependency>
      <groupId>org.cibseven.bpm</groupId>
      <artifactId>cibseven-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- ProcessEngineExtension und @Deployment für JUnit 5 -->
    <dependency>
      <groupId>org.cibseven.bpm</groupId>
      <artifactId>cibseven-bpm-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Prüfungen wie isWaitingAt, hasPassed, isEnded -->
    <dependency>
      <groupId>org.cibseven.bpm</groupId>
      <artifactId>cibseven-bpm-assert</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Abdeckung: ProcessEngineCoverageExtension ersetzt in den Tests die ProcessEngineExtension und erbt von ihr,
      die Prüfungen bleiben dieselben. Die Engine-Klasse dazu steht in src/test/resources/camunda.cfg.xml.
      Nach jeder Testklasse schreibt sie target/process-test-coverage/<Testklasse>/report.html: das Modell,
      darin markiert, was die Tests durchlaufen haben, und die Abdeckung in Prozent. Eine Mindestabdeckung
      verlangen die Tests nicht: Im Startstand sind drei von vier übersprungen.
    -->
    <dependency>
      <groupId>org.cibseven.community.process_test_coverage</groupId>
      <artifactId>cibseven-process-test-coverage-junit5-platform-7</artifactId>
      <version>${process-test-coverage.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Die Typen der erzeugten Klassen: ElementId, ProcessId, BpmnError -->
    <dependency>
      <groupId>io.miragon</groupId>
      <artifactId>bpmn-to-code-runtime</artifactId>
      <version>${bpmn-to-code.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${h2.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Logausgabe der Engine, leise gestellt in src/test/resources/simplelogger.properties -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Erzeugt vor dem Übersetzen der Tests (Phase generate-test-sources) je Modell eine Klasse mit Process ID,
        Element-IDs, Topics, Nachrichten und Fehlercodes, etwa ProcessGenehmigungProcessApi.Elements.TASK_PRUEFEN.
        Sie liegt unter target/, entsteht bei jedem Lauf neu aus dem Modell und gehört nicht ins Repo.
        Eine Ausführung je Modell, jede mit eigenem Paket: genehmigungsworkflow.bpmn und genehmigungsworkflow-tag1.bpmn
        tragen dieselbe Process ID und ergäben im selben Paket dieselbe Klasse. Fehlt ein Modell, etwa
        genehmigungsworkflow-tag1.bpmn im Startstand, erzeugt seine Ausführung nichts, und der Lauf geht weiter.
        Vorher leert maven-clean-plugin den Ordner. bpmn-to-code 5.2.0 löscht keine alten Klassen, nach einer
        geänderten Process ID übersetzte der Test sonst weiter gegen die alte Klasse.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>bpmn-api-leeren</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>clean</goal>
            </goals>
            <configuration>
              <excludeDefaultDirectories>true</excludeDefaultDirectories>
              <filesets>
                <fileset>
                  <directory>${bpmn-api.ordner}</directory>
                </fileset>
              </filesets>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>io.miragon</groupId>
        <artifactId>bpmn-to-code-maven</artifactId>
        <version>${bpmn-to-code.version}</version>
        <configuration>
          <baseDir>${project.basedir}</baseDir>
          <outputFolderPath>${bpmn-api.ordner}</outputFolderPath>
          <outputLanguage>JAVA</outputLanguage>
          <processEngine>CAMUNDA_7</processEngine>
        </configuration>
        <executions>
          <execution>
            <id>api-genehmigungsworkflow</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>generate-bpmn-api</goal>
            </goals>
            <configuration>
              <filePattern>src/main/resources/genehmigungsworkflow.bpmn</filePattern>
              <packagePath>io.miragon.schulung.genehmigung.api</packagePath>
            </configuration>
          </execution>
          <execution>
            <id>api-fehlerpfad</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>generate-bpmn-api</goal>
            </goals>
            <configuration>
              <filePattern>src/main/resources/verbuchen-fehlerpfad.bpmn</filePattern>
              <packagePath>io.miragon.schulung.genehmigung.api.fehlerpfad</packagePath>
            </configuration>
          </execution>
          <execution>
            <!-- Nur für die Demo in Kapitel 10, das Modell liegt nur in der Musterlösung -->
            <id>api-tag1</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>generate-bpmn-api</goal>
            </goals>
            <configuration>
              <filePattern>src/main/resources/genehmigungsworkflow-tag1.bpmn</filePattern>
              <packagePath>io.miragon.schulung.genehmigung.api.tag1</packagePath>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Meldet den Ordner der erzeugten Klassen als Testquellen an: Maven übersetzt sie mit den Tests, die IDE findet sie -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <id>bpmn-api-als-testquellen</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${bpmn-api.ordner}</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <!-- 3.5.3 ist die Version, gegen die der Tree-Reporter gebaut ist -->
        <version>3.5.3</version>
        <dependencies>
          <dependency>
            <groupId>me.fabriciorby</groupId>
            <artifactId>maven-surefire-junit5-tree-reporter</artifactId>
            <version>1.5.1</version>
          </dependency>
        </dependencies>
        <configuration>
          <!--
            Testausgabe als Baum mit den @DisplayName. Die Meldungen der roten Tests stehen darunter
            unter "Results", je Test eine Zeile mit dem Methodennamen, ohne die langen Stacktraces
            der Engine. Die vollständigen Berichte und die Logs aus dem Test liegen in
            target/surefire-reports, auf der Konsole erscheinen die Logs nicht.
          -->
          <reportFormat>plain</reportFormat>
          <consoleOutputReporter>
            <disable>true</disable>
          </consoleOutputReporter>
          <statelessTestsetInfoReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5StatelessTestsetInfoTreeReporter">
            <theme>${baum.theme}</theme>
            <printStacktraceOnError>false</printStacktraceOnError>
            <printStacktraceOnFailure>false</printStacktraceOnFailure>
            <printBlankLineBetweenTests>false</printBlankLineBetweenTests>
          </statelessTestsetInfoReporter>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
